# Core
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgresql://forgegov:forgegov@db:5432/forgegov
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Government data
# Never commit the real API key. Put it only in your local .env or deployment secret manager.
SAM_GOV_API_KEY=
SAM_GOV_BASE_URL=https://api.sam.gov/opportunities/v2/search
SAM_LIVE_SEARCH_RATE=10/day
SAM_DAILY_SYNC_LIMIT=1000
SAM_SYNC_ENABLED=false
USASPENDING_BASE_URL=https://api.usaspending.gov
