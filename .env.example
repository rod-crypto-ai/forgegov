# Core
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgresql://forgegov:forgegov@db:5432/forgegov
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Government data
# Never commit the real API key. Put it only in your local .env or deployment secret manager.
SAM_GOV_API_KEY=
SAM_GOV_BASE_URL=https://api.sam.gov/opportunities/v2/search
SAM_LIVE_SEARCH_RATE=120/hour
SAM_DAILY_SYNC_LIMIT=1000
SAM_SYNC_ENABLED=false
AUTH_LOGIN_RATE=10/minute
AUTH_REGISTER_RATE=5/hour
USASPENDING_BASE_URL=https://api.usaspending.gov

# Grants.gov public API; no API key required
GRANTS_GOV_BASE_URL=https://api.grants.gov/v1/api

FRONTEND_URL=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
PUBLIC_REGISTRATION_ENABLED=true
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# OpenAI (server-side only; never expose this key through NEXT_PUBLIC_* variables)
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_OUTPUT_TOKENS=1800
OPENAI_CHAT_RATE=60/hour
